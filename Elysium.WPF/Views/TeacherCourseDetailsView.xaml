<UserControl x:Class="Elysium.WPF.Views.TeacherCourseDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="BackButton"
                            Style="{StaticResource SecondaryButton}"
                            Content="Back to Dashboard"/>
                    <TextBlock Text="Course Details"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"/>
                </StackPanel>
                <Button x:Name="StartSessionButton"
                        Grid.Column="2"
                        Content="Start Session"
                        Style="{StaticResource PrimaryButton}"
                        VerticalAlignment="Center"
                        Click="StartSessionButton_Click"/>
            </Grid>

            <!-- Course info card -->
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardRadius}"
                    Padding="28"
                    Margin="0,0,0,28">
                <StackPanel>
                    <TextBlock x:Name="CourseNameText"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="CourseCodeText"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"
                               Margin="0,2,0,0"/>
                    <TextBlock x:Name="CourseDescriptionText"
                               FontSize="14"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                    <TextBlock x:Name="StatusNoticeText"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- Loading -->
            <StackPanel x:Name="SessionsLoadingPanel"
                        Orientation="Horizontal"
                        Margin="0,0,0,14"
                        Visibility="Collapsed">
                <ProgressBar Width="120" Height="4" IsIndeterminate="True"/>
                <TextBlock Text="Loading sessions..."
                           FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="10,0,0,0"/>
            </StackPanel>

            <!-- Error -->
            <TextBlock x:Name="SessionsErrorText"
                       Foreground="{StaticResource ErrorBrush}"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Margin="0,0,0,14"/>

            <!-- Live & scheduled sessions -->
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardRadius}"
                    Padding="28"
                    Margin="0,0,0,28">
                <StackPanel>
                    <TextBlock Text="Live &amp; Scheduled Sessions"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,18"/>

                    <ItemsControl x:Name="LiveSessionsList"
                                  Visibility="Collapsed"
                                  Margin="0,0,0,14">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BackgroundBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="18,14"
                                        Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding StartedAt, StringFormat=Started : {0:dd MMM yyyy HH:mm}}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="Live"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border x:Name="LiveEmptyPanel"
                            Background="{StaticResource BackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="24"
                            HorizontalAlignment="Left"
                            Width="360"
                            Visibility="Collapsed">
                        <TextBlock Text="No live sessions right now."
                                   FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Finished sessions -->
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardRadius}"
                    Padding="28">
                <StackPanel>
                    <TextBlock Text="Finished Sessions History"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,18"/>

                    <ItemsControl x:Name="FinishedSessionsList"
                                  Visibility="Collapsed"
                                  Margin="0,0,0,14">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BackgroundBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="18,14"
                                        Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding StartedAt, StringFormat=Held on : {0:dd MMM yyyy HH:mm}}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border x:Name="FinishedEmptyPanel"
                            Background="{StaticResource BackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="24"
                            HorizontalAlignment="Left"
                            Width="360"
                            Visibility="Collapsed">
                        <TextBlock Text="No finished sessions yet."
                                   FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>