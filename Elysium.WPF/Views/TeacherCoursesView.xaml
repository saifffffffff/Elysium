<UserControl x:Class="Elysium.WPF.Views.TeacherCoursesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <Button x:Name="BackButton"
                        Style="{StaticResource SecondaryButton}"
                        Content="Back to Dashboard"/>
                <TextBlock Text="Create Course"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"/>
            </StackPanel>

            <!-- Create course form -->
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardRadius}"
                    Padding="28">
                <StackPanel>
                    <TextBlock Text="Course Name"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,6"/>
                    <Border Style="{StaticResource ModernInputBorder}" Margin="0,0,0,4">
                        <TextBox x:Name="NameInput" Style="{StaticResource ModernTextBox}" MaxLength="128"/>
                    </Border>
                    <TextBlock x:Name="NameError"
                               Foreground="{StaticResource ErrorBrush}"
                               FontSize="12"
                               Margin="6,-8,0,0"/>

                    <TextBlock Text="Description (optional)"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,9,0,6"/>
                    <Border Style="{StaticResource ModernInputBorder}" Margin="0,0,0,4">
                        <TextBox x:Name="DescriptionInput"
                                 Style="{StaticResource ModernTextBox}"
                                 Height="110"
                                 MaxLength="512"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalContentAlignment="Top"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </Border>
                    <TextBlock x:Name="DescriptionError"
                               Foreground="{StaticResource ErrorBrush}"
                               FontSize="12"
                               Margin="6,-8,0,0"/>

                    <TextBlock x:Name="GeneralError"
                               Foreground="{StaticResource ErrorBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                    <TextBlock x:Name="SuccessText"
                               Text="Course created successfully!"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Visibility="Collapsed"/>
                    <TextBlock x:Name="CourseCodeText"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,6,0,0"
                               Visibility="Collapsed"/>
                    <StackPanel x:Name="CreateLoadingPanel"
                                Visibility="Collapsed"
                                Orientation="Horizontal"
                                Margin="0,12,0,0">
                        <ProgressBar Width="96" Height="4" IsIndeterminate="True"/>
                    </StackPanel>
                    <Button x:Name="CreateButton"
                            Style="{StaticResource SmallButton}"
                            Content="Create Course"
                            Width="160"
                            Margin="0,14,0,0"
                            HorizontalAlignment="Left"/>
                    <Button x:Name="CreateAnotherButton"
                            Style="{StaticResource SmallButton}"
                            Content="Create Another Course"
                            Width="190"
                            Margin="0,14,0,0"
                            HorizontalAlignment="Left"
                            Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>