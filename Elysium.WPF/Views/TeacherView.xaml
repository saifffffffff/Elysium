<Window x:Class="Elysium.WPF.Views.TeacherView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Elysium.WPF"
        xmlns:views="clr-namespace:Elysium.WPF.Views"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Title="Teacher Dashboard - Elysium"
        FontFamily="Segoe UI">
    <Grid Background="{StaticResource BackgroundBrush}">
        <!-- Header -->
        <Border Height="100" VerticalAlignment="Top"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#2563EB"/>
                    <GradientStop Color="#3B82F6" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Window chrome row -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0">
                    <Button x:Name="MinimizeButton"
                            Style="{StaticResource TitleBarButton}"
                            Content="&#x2014;"
                            ToolTip="Minimize"
                            Click="MinimizeButton_Click"/>
                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource TitleBarButton}"
                            Content="&#x2750;"
                            ToolTip="Maximize"
                            Click="MaximizeButton_Click"/>
                    <Button x:Name="CloseButton"
                            Style="{StaticResource CloseTitleBarButton}"
                            Content="&#x2715;"
                            ToolTip="Close"
                            Click="CloseButton_Click"/>
                </StackPanel>

                <!-- Main header row -->
                <Grid Grid.Row="1" Margin="30,0,30,0">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                        <Button x:Name="ProfileButton"
                                ToolTip="Profile"
                                Width="40"
                                Height="40"
                                Padding="0"
                                BorderThickness="0"
                                Background="Transparent"
                                Cursor="Hand"
                                Click="ProfileButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            Width="36"
                                            Height="36"
                                            CornerRadius="18"
                                            Background="#FFFFFF">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Viewbox Width="20" Height="20">
                                <Path Data="M12,12c2.21,0 4,-1.79 4,-4s-1.79,-4 -4,-4 -4,1.79 -4,4 1.79,4 4,4zM12,14c-2.67,0 -8,1.34 -8,4v2h16v-2c0,-2.66 -5.33,-4 -8,-4z"
                                      Fill="{StaticResource AccentBrush}" Stretch="Fill" Width="16"/>
                            </Viewbox>
                        </Button>
                        <TextBlock x:Name="UserNameTextBlock"
                                   Foreground="{StaticResource TextOnAccentBrush}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>
                    </StackPanel>
                    <Button x:Name="LogoutButton"
                            Style="{StaticResource SecondaryButton}"
                            Content="Sign Out"
                            MinWidth="100"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer x:Name="DashboardContent"
                      VerticalScrollBarVisibility="Auto"
                      Margin="30,108,30,0">
            <StackPanel>
                <!-- Welcome banner -->
                <Border Background="{StaticResource SurfaceAltBrush}"
                          CornerRadius="{StaticResource CardRadius}"
                          Padding="30"
                          Margin="0,0,0,28"
                          >
                    <StackPanel>
                        <TextBlock x:Name="WelcomeTextBlock"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="You have successfully logged in as a Teacher."
                                   FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- My Courses -->
                <Border Padding="28"
                          Margin="0,0,0,28"
                          Background="{StaticResource SurfaceBrush}"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1"
                          CornerRadius="{StaticResource CardRadius}"
                          >
                    <StackPanel>
                        <TextBlock Text="My Courses"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,18"/>

                        <!-- Loading -->
                        <StackPanel x:Name="CoursesLoadingPanel"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,14"
                                    Visibility="Collapsed">
                            <ProgressBar Width="120" Height="4" IsIndeterminate="True"/>
                            <TextBlock Text="Loading your courses..."
                                       FontSize="14"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="10,0,0,0"/>
                        </StackPanel>

                        <!-- Error -->
                        <TextBlock x:Name="CoursesErrorText"
                                   Foreground="{StaticResource ErrorBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14"/>

                        <!-- Course list -->
                        <ItemsControl x:Name="CoursesList"
                                      Visibility="Collapsed"
                                      Margin="0,0,0,14">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BackgroundBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="18,14"
                                            Margin="0,0,12,12"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="OnCourseCardClicked">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="18"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Code, StringFormat=Course Code : {0}}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding Description}"
                                                           FontSize="13"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,6,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Description}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding CreatedAt, StringFormat={}{0:dd MMM yyyy}}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty state -->
                        <Border x:Name="EmptyCoursesPanel"
                                Background="{StaticResource BackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="24"
                                Margin="0,0,0,14"
                                HorizontalAlignment="Left"
                                Width="320"
                                Visibility="Collapsed">
                            <TextBlock Text="You haven't created any courses yet."
                                       FontSize="14"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </Border>

                        <Button x:Name="CreateCourseButton"
                                Content="Create New Course"
                                Style="{StaticResource SmallButton}"
                                Width="170"
                                Click="CreateCourseButton_Click"/>
                    </StackPanel>
                </Border>

                <!-- Statistics -->
                <Border Padding="28"
                          Margin="0,0,0,28"
                          Background="{StaticResource SurfaceBrush}"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1"
                          CornerRadius="{StaticResource CardRadius}"
                          >
                    <StackPanel>
                        <TextBlock Text="Teaching Statistics"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,18"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Border Background="{StaticResource BackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="20"
                                    Grid.Column="0">
                                <StackPanel>
                                    <TextBlock Text="0" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="Active Courses" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource BackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="20"
                                    Grid.Column="1"
                                    Margin="15,0,15,0">
                                <StackPanel>
                                    <TextBlock Text="0" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="Total Students" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource BackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="20"
                                    Grid.Column="2">
                                <StackPanel>
                                    <TextBlock Text="0" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="Pending Reviews" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Quick actions -->
                <Border Padding="28"
                          Background="{StaticResource SurfaceBrush}"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1"
                          CornerRadius="{StaticResource CardRadius}"
                          >
                    <StackPanel>
                        <TextBlock Text="Quick Actions"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,18"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="Create Assignment"
                                    Style="{StaticResource SmallButton}"
                                    Width="160"
                                    Margin="0,0,16,0"/>
                            <Button Content="Manage Students"
                                    Style="{StaticResource SmallButton}"
                                    Width="150"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="No active sessions"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,24,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Profile panel -->
        <views:ProfileView x:Name="ProfilePanel"
                           Visibility="Collapsed"
                           Margin="30,108,30,0"/>

        <!-- Courses panel -->
        <views:TeacherCoursesView x:Name="CoursePanel"
                                    Visibility="Collapsed"
                                    Margin="30,108,30,0"/>

        <!-- Course details panel -->
        <views:TeacherCourseDetailsView x:Name="CourseDetailsPanel"
                                        Visibility="Collapsed"
                                        Margin="30,108,30,0"/>

        <!-- Session panel -->
        <views:TeacherSessionView x:Name="SessionPanel"
                                  Visibility="Collapsed"
                                  Margin="0,108,0,0"/>

        <!-- Leave confirmation overlay -->
        <Grid x:Name="LeaveConfirmOverlay"
              Margin="0,-100,0,0"
              Background="#660F172A"
              Visibility="Collapsed">
            <Border Width="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardRadius}"
                    Padding="28"
                    Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="44"
                                Height="44"
                                CornerRadius="22"
                                Background="#FEE2E2"
                                VerticalAlignment="Center">
                            <TextBlock Text="!"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource DangerBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="16,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="End Session"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Are you sure you want to end this session?"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="LeaveConfirmMessage"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,24"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button x:Name="CancelLeaveButton"
                                Style="{StaticResource SecondaryButton}"
                                Content="Cancel"
                                MinWidth="110"
                                Margin="0,0,12,0"
                                Click="CancelLeaveButton_Click"/>
                        <Button x:Name="ConfirmLeaveButton"
                                Style="{StaticResource DangerButton}"
                                Content="Yes, End Session"
                                MinWidth="150"
                                Click="ConfirmLeaveButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
