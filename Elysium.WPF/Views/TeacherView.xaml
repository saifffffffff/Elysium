<Window x:Class="Elysium.WPF.Views.TeacherView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Elysium.WPF"
        xmlns:views="clr-namespace:Elysium.WPF.Views"
        xmlns:teacher="clr-namespace:Elysium.WPF.Views.Teacher"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        WindowState="Maximized"
        Title="Teacher Dashboard - Elysium"
        FontFamily="Segoe UI">
    <Grid Background="{StaticResource BackgroundBrush}">
        <!-- Header -->
        <Border Height="70" VerticalAlignment="Top">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#2563EB"/>
                    <GradientStop Color="#3B82F6" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <TextBlock Text="Elysium - Teacher Dashboard"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextOnAccentBrush}"
                           VerticalAlignment="Center"
                           Margin="30,0,0,0"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,30,0">
                    <Button x:Name="ProfileButton"
                            Style="{StaticResource TitleBarButton}"
                            ToolTip="Profile"
                            Margin="0,0,12,0"
                            Click="ProfileButton_Click">
                        <Path Data="M12,12c2.21,0 4,-1.79 4,-4s-1.79,-4 -4,-4 -4,1.79 -4,4 1.79,4 4,4zM12,14c-2.67,0 -8,1.34 -8,4v2h16v-2c0,-2.66 -5.33,-4 -8,-4z"
                              Fill="{StaticResource TextOnAccentBrush}"/>
                    </Button>
                    <TextBlock x:Name="UserNameTextBlock"
                               Foreground="{StaticResource TextOnAccentBrush}"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Margin="0,0,20,0"/>
                    <Button x:Name="LogoutButton"
                            Style="{StaticResource SecondaryButton}"
                            Content="Sign Out"
                            MinWidth="100"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer x:Name="DashboardContent"
                      VerticalScrollBarVisibility="Auto"
                      Margin="30,78,30,0">
            <StackPanel>
                <!-- Welcome banner -->
                <Border Background="{StaticResource SurfaceAltBrush}"
                          CornerRadius="{StaticResource CardRadius}"
                          Padding="30"
                          Margin="0,0,0,28"
                          >
                    <StackPanel>
                        <TextBlock x:Name="WelcomeTextBlock"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="You have successfully logged in as a Teacher."
                                   FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- My Courses -->
                <Border Padding="28"
                          Margin="0,0,0,28"
                          Background="{StaticResource SurfaceBrush}"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1"
                          CornerRadius="{StaticResource CardRadius}"
                          >
                    <StackPanel>
                        <TextBlock Text="My Courses"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,18"/>

                        <!-- Loading -->
                        <StackPanel x:Name="CoursesLoadingPanel"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,14"
                                    Visibility="Collapsed">
                            <ProgressBar Width="120" Height="4" IsIndeterminate="True"/>
                            <TextBlock Text="Loading your courses..."
                                       FontSize="14"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="10,0,0,0"/>
                        </StackPanel>

                        <!-- Error -->
                        <TextBlock x:Name="CoursesErrorText"
                                   Foreground="{StaticResource ErrorBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14"/>

                        <!-- Course list -->
                        <ItemsControl x:Name="CoursesList"
                                      Visibility="Collapsed"
                                      Margin="0,0,0,14">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BackgroundBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="18,14"
                                            Margin="0,0,0,10"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="OnCourseCardClicked">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="18"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Code, StringFormat=Course Code : {0}}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding Description}"
                                                           FontSize="13"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,6,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Description}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding CreatedAt, StringFormat={}{0:dd MMM yyyy}}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty state -->
                        <Border x:Name="EmptyCoursesPanel"
                                Background="{StaticResource BackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="24"
                                Margin="0,0,0,14"
                                HorizontalAlignment="Left"
                                Width="320"
                                Visibility="Collapsed">
                            <TextBlock Text="You haven't created any courses yet."
                                       FontSize="14"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </Border>

                        <Button x:Name="CreateCourseButton"
                                Content="Create New Course"
                                Style="{StaticResource SmallButton}"
                                Width="170"
                                Click="CreateCourseButton_Click"/>
                    </StackPanel>
                </Border>

                <!-- Statistics -->
                <Border Padding="28"
                          Margin="0,0,0,28"
                          Background="{StaticResource SurfaceBrush}"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1"
                          CornerRadius="{StaticResource CardRadius}"
                          >
                    <StackPanel>
                        <TextBlock Text="Teaching Statistics"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,18"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Border Background="{StaticResource BackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="20"
                                    Grid.Column="0">
                                <StackPanel>
                                    <TextBlock Text="0" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="Active Courses" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource BackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="20"
                                    Grid.Column="1"
                                    Margin="15,0,15,0">
                                <StackPanel>
                                    <TextBlock Text="0" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="Total Students" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource BackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="20"
                                    Grid.Column="2">
                                <StackPanel>
                                    <TextBlock Text="0" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="Pending Reviews" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Quick actions -->
                <Border Padding="28"
                          Background="{StaticResource SurfaceBrush}"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1"
                          CornerRadius="{StaticResource CardRadius}"
                          >
                    <StackPanel>
                        <TextBlock Text="Quick Actions"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,18"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="Create Assignment"
                                    Style="{StaticResource SmallButton}"
                                    Width="160"
                                    Margin="0,0,16,0"/>
                            <Button Content="Manage Students"
                                    Style="{StaticResource SmallButton}"
                                    Width="150"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="No active sessions"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,24,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Profile panel -->
        <views:ProfileView x:Name="ProfilePanel"
                           Visibility="Collapsed"
                           Margin="30,78,30,0"/>

        <!-- Courses panel -->
        <teacher:TeacherCoursesView x:Name="CoursePanel"
                                    Visibility="Collapsed"
                                    Margin="30,78,30,0"/>

        <!-- Course details panel -->
        <views:TeacherCourseDetailsView x:Name="CourseDetailsPanel"
                                        Visibility="Collapsed"
                                        Margin="30,78,30,0"/>
    </Grid>
</Window>
