<Window x:Class="Elysium.WPF.Views.TeacherView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Elysium.WPF"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        WindowState="Maximized"
        Title="Teacher Dashboard - Elysium"
        FontFamily="Segoe UI">
    <Grid Background="{StaticResource BackgroundBrush}">
        <!-- Header -->
        <Border Height="70" VerticalAlignment="Top">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#2563EB"/>
                    <GradientStop Color="#3B82F6" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <TextBlock Text="Elysium - Teacher Dashboard"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextOnAccentBrush}"
                           VerticalAlignment="Center"
                           Margin="30,0,0,0"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,30,0">
                    <TextBlock x:Name="UserNameTextBlock"
                               Foreground="{StaticResource TextOnAccentBrush}"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Margin="0,0,20,0"/>
                    <Button x:Name="LogoutButton"
                            Style="{StaticResource SecondaryButton}"
                            Content="Sign Out"
                            MinWidth="100"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Margin="30,78,30,0">
            <StackPanel>
                <!-- Welcome banner -->
                <Border Background="{StaticResource SurfaceAltBrush}"
                          CornerRadius="{StaticResource CardRadius}"
                          Padding="30"
                          Margin="0,0,0,28"
                          Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <TextBlock x:Name="WelcomeTextBlock"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="You have successfully logged in as a Teacher."
                                   FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- My Courses -->
                <Border Padding="28"
                          Margin="0,0,0,28"
                          Background="{StaticResource SurfaceBrush}"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1"
                          CornerRadius="{StaticResource CardRadius}"
                          Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <TextBlock Text="My Courses"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,18"/>

                        <Border Background="{StaticResource BackgroundBrush}"
                                  BorderBrush="{StaticResource BorderBrush}"
                                  BorderThickness="1"
                                  CornerRadius="10"
                                  Padding="24"
                                  Margin="0,0,0,14"
                                  HorizontalAlignment="Left"
                                  Width="320">
                            <TextBlock Text="No courses created yet"
                                       FontSize="14"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </Border>

                        <Button Content="Create New Course"
                                Style="{StaticResource SmallButton}"
                                Width="170"/>
                    </StackPanel>
                </Border>

                <!-- Statistics -->
                <Border Padding="28"
                          Margin="0,0,0,28"
                          Background="{StaticResource SurfaceBrush}"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1"
                          CornerRadius="{StaticResource CardRadius}"
                          Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <TextBlock Text="Teaching Statistics"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,18"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Border Background="{StaticResource BackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="20"
                                    Grid.Column="0">
                                <StackPanel>
                                    <TextBlock Text="0" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="Active Courses" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource BackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="20"
                                    Grid.Column="1"
                                    Margin="15,0,15,0">
                                <StackPanel>
                                    <TextBlock Text="0" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="Total Students" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource BackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="20"
                                    Grid.Column="2">
                                <StackPanel>
                                    <TextBlock Text="0" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="Pending Reviews" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Quick actions -->
                <Border Padding="28"
                          Background="{StaticResource SurfaceBrush}"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1"
                          CornerRadius="{StaticResource CardRadius}"
                          Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <TextBlock Text="Quick Actions"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,18"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="Create Assignment"
                                    Style="{StaticResource SmallButton}"
                                    Width="160"
                                    Margin="0,0,16,0"/>
                            <Button Content="Manage Students"
                                    Style="{StaticResource SmallButton}"
                                    Width="150"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="No active sessions"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,24,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
