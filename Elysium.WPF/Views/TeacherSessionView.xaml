<UserControl x:Class="Elysium.WPF.Views.TeacherSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="30,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ContentControl Style="{StaticResource LiveIndicator}"/>
                    <TextBlock x:Name="SessionNameText"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                    <TextBlock Text="Live"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource LiveIndicatorBrush}"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                </StackPanel>
                <Button x:Name="EndSessionButton"
                        Grid.Column="1"
                        Style="{StaticResource DangerButton}"
                        Content="End Session"
                        MinWidth="150"
                        Click="EndSessionButton_Click"/>
            </Grid>
        </Border>

        <!-- Live transcript -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CardRadius}"
                Padding="24"
                Margin="30,24,30,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="Live Transcript"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,14"/>
                <ScrollViewer x:Name="TranscriptScrollViewer"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="TranscriptList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BackgroundBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14,10"
                                        Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Text}"
                                               FontSize="14"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Bottom bar: mic mute/unmute -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,12">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Button x:Name="MicToggleButton"
                        Width="44"
                        Height="44"
                        Padding="0"
                        BorderThickness="0"
                        Background="Transparent"
                        Cursor="Hand"
                        ToolTip="Mute / Unmute"
                        Click="MicToggleButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Width="44"
                                    Height="44"
                                    CornerRadius="22"
                                    Background="{StaticResource SurfaceAltBrush}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Grid Width="22" Height="22">
                        <Path x:Name="MicOnIcon"
                              Data="M12,14c1.66,0 2.99,-1.34 2.99,-3L15,5c0,-1.66 -1.34,-3 -3,-3S9,3.34 9,5v6c0,1.66 1.34,3 3,3zM17.3,11c0,3 -2.54,5.1 -5.3,5.1S6.7,14 6.7,11L5,11c0,3.41 2.72,6.23 6,6.72L11,21h2v-3.28c3.28,-0.48 6,-3.3 6,-6.72h-1.7z"
                              Fill="{StaticResource AccentBrush}"
                              Stretch="Uniform"/>
                        <Grid x:Name="MicOffIcon" Visibility="Collapsed">
                            <Path Data="M12,14c1.66,0 2.99,-1.34 2.99,-3L15,5c0,-1.66 -1.34,-3 -3,-3S9,3.34 9,5v6c0,1.66 1.34,3 3,3zM17.3,11c0,3 -2.54,5.1 -5.3,5.1S6.7,14 6.7,11L5,11c0,3.41 2.72,6.23 6,6.72L11,21h2v-3.28c3.28,-0.48 6,-3.3 6,-6.72h-1.7z"
                                  Fill="{StaticResource ErrorBrush}"
                                  Stretch="Uniform"/>
                            <Line X1="2" Y1="2" X2="20" Y2="20"
                                  Stroke="{StaticResource ErrorBrush}"
                                  StrokeThickness="2.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Grid>
                    </Grid>
                </Button>
                <TextBlock x:Name="MicStatusText"
                           Text="Listening"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- End session confirmation overlay -->
        <Grid x:Name="EndConfirmOverlay"
              Grid.RowSpan="3"
              Margin="0,-108,0,0"
              Background="#660F172A"
              Visibility="Collapsed">
            <Border Width="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardRadius}"
                    Padding="28"
                    Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="44"
                                Height="44"
                                CornerRadius="22"
                                Background="#FEE2E2"
                                VerticalAlignment="Center">
                            <TextBlock Text="!"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource DangerBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="16,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="End Session"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Are you sure you want to end this session?"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="All students will be notified that the session has ended and the live transcript will be closed."
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,24"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button x:Name="CancelEndButton"
                                Style="{StaticResource SecondaryButton}"
                                Content="Cancel"
                                MinWidth="110"
                                Margin="0,0,12,0"
                                Click="CancelEndButton_Click"/>
                        <Button x:Name="ConfirmEndButton"
                                Style="{StaticResource DangerButton}"
                                Content="Yes, End Session"
                                MinWidth="150"
                                Click="ConfirmEndButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>