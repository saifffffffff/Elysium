<Window x:Class="Elysium.WPF.Views.SignInView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Elysium.WPF"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:diag="clr-namespace:System.Diagnostics;assembly=WindowsBase"
        WindowStartupLocation="CenterScreen"
        Width="960"
        Height="720"
        WindowState="Normal"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Title="Elysium - Sign In">
    <Border x:Name="WindowFrame"
            Background="{StaticResource SurfaceBrush}"
            CornerRadius="20"
            Effect="{StaticResource CardShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== Custom title bar ===== -->
            <Border x:Name="TitleBar"
                    Grid.Row="0"
                    Height="44"
                    Background="{StaticResource HeaderGradient}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="Elysium"
                               Foreground="{StaticResource TextOnAccentBrush}"
                               FontWeight="SemiBold"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0">
                        <Button x:Name="MinimizeButton"
                                Style="{StaticResource TitleBarButton}"
                                Content="—"
                                Click="MinimizeButton_Click"/>
                        <Button x:Name="MaximizeButton"
                                Style="{StaticResource TitleBarButton}"
                                Content="❐"
                                IsEnabled="False"/>
                        <Button x:Name="CloseButton"
                                Style="{StaticResource CloseTitleBarButton}"
                                Content="✕"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Main content ===== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="460"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border x:Name="Sidebar"
                        Grid.Column="0"
                        Background="{StaticResource HeaderGradient}"
                        VerticalAlignment="Stretch">
                    <StackPanel VerticalAlignment="Center" Margin="44">
                        <TextBlock x:Name="HeaderTitle"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextOnAccentBrush}"
                                   Text="Welcome Back"/>
                        <TextBlock x:Name="HeaderSubtitle"
                                   FontSize="15"
                                   Foreground="#E0E8F5"
                                   TextWrapping="Wrap"
                                   LineHeight="24"
                                   Text="Sign in to your account to continue learning and teaching."
                                   Margin="0,10,0,0"/>

                        <StackPanel Margin="0,24,0,0">
                            <TextBlock Text="Access your courses" FontSize="13" Foreground="{StaticResource TextOnAccentBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="Track your progress" FontSize="13" Foreground="{StaticResource TextOnAccentBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="Connect with peers" FontSize="13" Foreground="{StaticResource TextOnAccentBrush}" Margin="0,0,0,8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Form area: two layered panels that slide -->
                <Grid Grid.Column="1"
                      Background="{StaticResource BackgroundBrush}">
                    <Grid.Clip>
                        <RectangleGeometry Rect="0,0,1000,1000"/>
                    </Grid.Clip>

                    <!-- Sign In panel -->
                    <StackPanel x:Name="SignInPanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="380"
                                Opacity="1">
                        <StackPanel.RenderTransform>
                            <TranslateTransform X="0" Y="0"/>
                        </StackPanel.RenderTransform>
                        <TextBlock Text="Sign In"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Enter your credentials to access your account"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,4,0,16"/>

                        <TextBlock Text="Username"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,6"/>
                        <Border Style="{StaticResource ModernInputBorder}" Margin="0,0,0,4">
                            <TextBox x:Name="SignInUsernameTextBox"
                                     Style="{StaticResource ModernTextBox}"
                                     FontSize="14"/>
                        </Border>
                        <TextBlock x:Name="SignInUsernameError"
                                   Foreground="{StaticResource ErrorBrush}"
                                   FontSize="12"
                                   Margin="6,-8,0,0"/>

                        <TextBlock Text="Password"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,9,0,6"/>
                        <Border Style="{StaticResource ModernInputBorder}" Margin="0,0,0,4">
                            <PasswordBox x:Name="SignInPasswordBox"
                                         Style="{StaticResource ModernPasswordBox}"/>
                        </Border>
                        <TextBlock x:Name="SignInPasswordError"
                                   Foreground="{StaticResource ErrorBrush}"
                                   FontSize="12"
                                   Margin="6,-8,0,0"/>

                        <TextBlock x:Name="SignInGeneralError"
                                   Foreground="{StaticResource ErrorBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>

                        <Button x:Name="SignInButton"
                                Style="{StaticResource PrimaryButton}"
                                Content="Sign In"
                                Margin="0,18,0,0"/>

                        <StackPanel x:Name="SignInLoadingPanel"
                                    Visibility="Collapsed"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,14,0,0">
                            <ProgressBar Width="96" Height="4" IsIndeterminate="True"/>
                        </StackPanel>

                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   Margin="0,14,0,0">
                            <Run Text="Don't have an account? "/>
                            <Hyperlink x:Name="SignUpLink"
                                       Foreground="{StaticResource AccentBrush}"
                                       TextDecorations="None">
                                <Run Text="Create one here"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>

                    <!-- Sign Up panel -->
                    <StackPanel x:Name="SignUpPanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="380"
                                Opacity="0">
                        <StackPanel.RenderTransform>
                            <TranslateTransform X="380" Y="0"/>
                        </StackPanel.RenderTransform>
                        <TextBlock Text="Create Account"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Fill in your information to register"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,4,0,16"/>

                        <TextBlock Text="Username"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,6"/>
                        <Border Style="{StaticResource ModernInputBorder}" Margin="0,0,0,4">
                            <TextBox x:Name="SignUpUsernameTextBox"
                                     Style="{StaticResource ModernTextBox}"/>
                        </Border>
                        <TextBlock x:Name="SignUpUsernameError"
                                   Foreground="{StaticResource ErrorBrush}"
                                   FontSize="12"
                                   Margin="6,-8,0,0"/>

                        <TextBlock Text="Password"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,9,0,6"/>
                        <Border Style="{StaticResource ModernInputBorder}" Margin="0,0,0,4">
                            <PasswordBox x:Name="SignUpPasswordBox"
                                         Style="{StaticResource ModernPasswordBox}"/>
                        </Border>
                        <TextBlock x:Name="SignUpPasswordError"
                                   Foreground="{StaticResource ErrorBrush}"
                                   FontSize="12"
                                   Margin="6,-8,0,0"/>

                        <TextBlock Text="First Name"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,9,0,6"/>
                        <Border Style="{StaticResource ModernInputBorder}" Margin="0,0,0,4">
                            <TextBox x:Name="SignUpFirstNameBox"
                                     Style="{StaticResource ModernTextBox}"/>
                        </Border>
                        <TextBlock x:Name="SignUpFirstNameError"
                                   Foreground="{StaticResource ErrorBrush}"
                                   FontSize="12"
                                   Margin="6,-8,0,0"/>

                        <TextBlock Text="Last Name"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,9,0,6"/>
                        <Border Style="{StaticResource ModernInputBorder}" Margin="0,0,0,4">
                            <TextBox x:Name="SignUpLastNameBox"
                                     Style="{StaticResource ModernTextBox}"/>
                        </Border>
                        <TextBlock x:Name="SignUpLastNameError"
                                   Foreground="{StaticResource ErrorBrush}"
                                   FontSize="12"
                                   Margin="6,-8,0,0"/>

                        <TextBlock Text="Birth Date"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,9,0,6"/>
                        <Border Style="{StaticResource ModernInputBorder}" Margin="0,0,0,4">
                            <DatePicker x:Name="BirthDatePicker"
                                        Background="Transparent"
                                        BorderBrush="{x:Static SystemColors.ControlDarkDarkBrush}"
                                        BorderThickness="0"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        FontSize="14"
                                        Padding="0"
                                        HorizontalAlignment="Stretch"/>
                        </Border>
                        <TextBlock x:Name="SignUpBirthError"
                                   Foreground="{StaticResource ErrorBrush}"
                                   FontSize="12"
                                   Margin="6,-8,0,0"/>

                        <TextBlock Text="Role"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,9,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton x:Name="StudentRadio"
                                         Style="{StaticResource ModernRadioButton}"
                                         Content="Student"
                                         GroupName="Role"
                                         IsChecked="True"
                                         Margin="0,0,16,0"/>
                            <RadioButton x:Name="TeacherRadio"
                                         Style="{StaticResource ModernRadioButton}"
                                         Content="Teacher"
                                         GroupName="Role"/>
                        </StackPanel>

                        <TextBlock x:Name="SignUpGeneralError"
                                   Foreground="{StaticResource ErrorBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,4"/>

                        <Button x:Name="SignUpButton"
                                Style="{StaticResource PrimaryButton}"
                                Content="Create Account"/>

                        <StackPanel x:Name="SignUpLoadingPanel"
                                    Visibility="Collapsed"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,14,0,0">
                            <ProgressBar Width="96" Height="4" IsIndeterminate="True"/>
                        </StackPanel>

                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   Margin="0,14,0,0">
                            <Run Text="Already have an account? "/>
                            <Hyperlink x:Name="SignInLink"
                                       Foreground="{StaticResource AccentBrush}"
                                       TextDecorations="None">
                                <Run Text="Sign in here"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
