<Window x:Class="Elysium.WPF.Views.StudentView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Elysium.WPF"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        WindowState="Maximized"
        Title="Student Dashboard - Elysium"
        FontFamily="Segoe UI">
    <Grid Background="{StaticResource BackgroundBrush}">
        <!-- Header -->
        <Border Height="70" VerticalAlignment="Top">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#2563EB"/>
                    <GradientStop Color="#3B82F6" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <TextBlock Text="Elysium - Student Dashboard"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextOnAccentBrush}"
                           VerticalAlignment="Center"
                           Margin="30,0,0,0"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,30,0">
                    <TextBlock x:Name="UserNameTextBlock"
                               Foreground="{StaticResource TextOnAccentBrush}"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Margin="0,0,20,0"/>
                    <Button x:Name="LogoutButton"
                            Style="{StaticResource SecondaryButton}"
                            Content="Sign Out"
                            MinWidth="100"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Margin="30,78,30,0">
            <StackPanel>
                <!-- Welcome banner -->
                <Border Background="{StaticResource SurfaceAltBrush}"
                          CornerRadius="{StaticResource CardRadius}"
                          Padding="30"
                          Margin="0,0,0,28"
                          Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <TextBlock x:Name="WelcomeTextBlock"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="You have successfully logged in as a Student."
                                   FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Courses -->
                <Border Padding="28"
                          Margin="0,0,0,28"
                          Background="{StaticResource SurfaceBrush}"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1"
                          CornerRadius="{StaticResource CardRadius}"
                          Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <TextBlock Text="My Courses"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,18"/>

                        <Border Background="{StaticResource BackgroundBrush}"
                                  BorderBrush="{StaticResource BorderBrush}"
                                  BorderThickness="1"
                                  CornerRadius="10"
                                  Padding="24"
                                  Margin="0,0,0,12"
                                  HorizontalAlignment="Left"
                                  Width="320">
                            <TextBlock Text="No courses yet"
                                       FontSize="14"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Explore available courses to start learning."
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>

                        <Button Content="Browse Courses"
                                Style="{StaticResource SmallButton}"
                                Width="150"
                                Margin="0,16,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Progress -->
                <Border Padding="28"
                          Background="{StaticResource SurfaceBrush}"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1"
                          CornerRadius="{StaticResource CardRadius}"
                          Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <TextBlock Text="Your Progress"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,18"/>

                        <Border Background="{StaticResource BackgroundBrush}"
                                  BorderBrush="{StaticResource BorderBrush}"
                                  BorderThickness="1"
                                  CornerRadius="10"
                                  Padding="24"
                                  HorizontalAlignment="Left">
                            <TextBlock Text="Complete your courses to track your progress here."
                                       FontSize="14"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
