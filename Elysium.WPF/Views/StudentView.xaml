<Window x:Class="Elysium.WPF.Views.StudentView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Elysium.WPF"
        xmlns:views="clr-namespace:Elysium.WPF.Views"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        WindowState="Maximized"
        Title="Student Dashboard - Elysium"
        FontFamily="Segoe UI">
    <Grid Background="{StaticResource BackgroundBrush}">
        <!-- Header -->
        <Border Height="70" VerticalAlignment="Top">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#2563EB"/>
                    <GradientStop Color="#3B82F6" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <TextBlock Text="Elysium - Student Dashboard"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextOnAccentBrush}"
                           VerticalAlignment="Center"
                           Margin="30,0,0,0"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,30,0">
                    <Button x:Name="ProfileButton"
                            Style="{StaticResource TitleBarButton}"
                            ToolTip="Profile"
                            Margin="0,0,12,0"
                            Click="ProfileButton_Click">
                        <Path Data="M12,12c2.21,0 4,-1.79 4,-4s-1.79,-4 -4,-4 -4,1.79 -4,4 1.79,4 4,4zM12,14c-2.67,0 -8,1.34 -8,4v2h16v-2c0,-2.66 -5.33,-4 -8,-4z"
                              Fill="{StaticResource TextOnAccentBrush}"/>
                    </Button>
                    <TextBlock x:Name="UserNameTextBlock"
                               Foreground="{StaticResource TextOnAccentBrush}"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Margin="0,0,20,0"/>
                    <Button x:Name="LogoutButton"
                            Style="{StaticResource SecondaryButton}"
                            Content="Sign Out"
                            MinWidth="100"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer x:Name="DashboardContent"
                      VerticalScrollBarVisibility="Auto"
                      Margin="30,78,30,0">
            <StackPanel>
                <!-- Welcome banner -->
                <Border Background="{StaticResource SurfaceAltBrush}"
                          CornerRadius="{StaticResource CardRadius}"
                          Padding="30"
                          Margin="0,0,0,28"
                          >
                    <StackPanel>
                        <TextBlock x:Name="WelcomeTextBlock"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="You have successfully logged in as a Student."
                                   FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Courses -->
                <Border Padding="28"
                          Margin="0,0,0,28"
                          Background="{StaticResource SurfaceBrush}"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1"
                          CornerRadius="{StaticResource CardRadius}"
                          >
                    <StackPanel>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="My Courses"
                                           FontSize="19"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,0,0,4"/>

                                <TextBlock Text="Courses you are currently enrolled in."
                                           FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <Button x:Name="EnrollCourseButton"
                                    Grid.Column="1"
                                    Content="Enroll in Course"
                                    Style="{StaticResource SmallButton}"
                                    VerticalAlignment="Center"
                                    Click="EnrollCourseButton_Click"/>
                        </Grid>

                        <!-- Loading -->
                        <StackPanel x:Name="CoursesLoadingPanel"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,14"
                                    Visibility="Collapsed">
                            <ProgressBar Width="120" Height="4" IsIndeterminate="True"/>
                            <TextBlock Text="Loading your courses..."
                                       FontSize="14"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="10,0,0,0"/>
                        </StackPanel>

                        <!-- Error -->
                        <TextBlock x:Name="CoursesErrorText"
                                   Foreground="{StaticResource ErrorBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14"/>

                        <!-- Course list -->
                        <ItemsControl x:Name="CoursesList"
                                      Visibility="Collapsed"
                                      Margin="0,0,0,14">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BackgroundBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="18,14"
                                            Margin="0,0,12,12"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="OnCourseCardClicked">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="18"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Code, StringFormat=Course Code : {0}}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding Description}"
                                                           FontSize="13"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,6,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Description}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding CreatedAt, StringFormat={}{0:dd MMM yyyy}}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty state -->
                        <Border x:Name="EmptyCoursesPanel"
                                Background="{StaticResource BackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="24"
                                Margin="0,0,0,14"
                                HorizontalAlignment="Left"
                                Width="360"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="No courses yet"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="You are not enrolled in any courses yet."
                                           FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Progress -->
                <Border Padding="28"
                          Background="{StaticResource SurfaceBrush}"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1"
                          CornerRadius="{StaticResource CardRadius}"
                          >
                    <StackPanel>
                        <TextBlock Text="Your Progress"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,18"/>

                        <Border Background="{StaticResource BackgroundBrush}"
                                  BorderBrush="{StaticResource BorderBrush}"
                                  BorderThickness="1"
                                  CornerRadius="10"
                                  Padding="24"
                                  HorizontalAlignment="Left">
                            <TextBlock Text="Complete your courses to track your progress here."
                                       FontSize="14"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Profile panel -->
        <views:ProfileView x:Name="ProfilePanel"
                           Visibility="Collapsed"
                           Margin="30,78,30,0"/>

        <!-- Enroll panel -->
        <Border x:Name="EnrollPanel"
                Visibility="Collapsed"
                Margin="30,78,30,0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CardRadius}"
                Padding="28">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <Button x:Name="BackFromEnrollButton"
                                Style="{StaticResource SecondaryButton}"
                                Content="Back to Dashboard"
                                Click="BackFromEnrollButton_Click"/>
                        <TextBlock Text="Enroll in Course"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0"/>
                    </StackPanel>

                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CardRadius}"
                            Padding="28">
                        <StackPanel>
                            <TextBlock Text="Enter the course code provided by your teacher."
                                       FontSize="14"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,18"/>

                            <TextBlock Text="Course Code"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,6"/>
                            <Border Style="{StaticResource ModernInputBorder}" Margin="0,0,0,4" HorizontalAlignment="Left" Width="280">
                                <TextBox x:Name="CourseCodeInput"
                                         Style="{StaticResource ModernTextBox}"
                                         MaxLength="6"
                                         KeyDown="CourseCodeInput_KeyDown"/>
                            </Border>
                            <TextBlock x:Name="CourseCodeError"
                                       Foreground="{StaticResource ErrorBrush}"
                                       FontSize="12"
                                       Margin="6,-8,0,0"/>

                            <TextBlock x:Name="EnrollGeneralError"
                                       Foreground="{StaticResource ErrorBrush}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>

                            <StackPanel x:Name="EnrollLoadingPanel"
                                        Orientation="Horizontal"
                                        Visibility="Collapsed"
                                        Margin="0,12,0,0">
                                <ProgressBar Width="96" Height="4" IsIndeterminate="True"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button x:Name="CancelEnrollButton"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="Cancel"
                                        MinWidth="100"
                                        Margin="0,0,12,0"
                                        Click="CancelEnrollButton_Click"/>
                                <Button x:Name="EnrollButton"
                                        Style="{StaticResource SmallButton}"
                                        Content="Enroll"
                                        MinWidth="110"
                                        Click="EnrollButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Course details panel -->
        <views:StudentCourseDetailsView x:Name="CourseDetailsPanel"
                                        Visibility="Collapsed"
                                        Margin="30,78,30,0"/>
    </Grid>
</Window>
